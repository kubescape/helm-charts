                      allowPrivilegeEscalation: false
                      readOnlyRootFilesystem: true
                      runAsNonRoot: true
                      runAsUser: 65532
                      runAsGroup: 65532
                      capabilities:
                        drop:
                          - ALL
                    resources:
                      limits:
                        cpu: 100m
                        memory: 128Mi
                      requests:
                        cpu: 10m
                        memory: 32Mi
                    command: ["/usr/bin/kubescape-ops-tool", "create-operator-command"]
                    args:
                      - --namespace
                      - kubescape
                      - --request-body
                      - /home/ks/request-body.json
