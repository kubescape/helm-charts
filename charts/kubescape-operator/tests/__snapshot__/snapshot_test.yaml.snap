nl.', 'xmc.antpool.com.', 'xmr-asia1.nanopool.org.', 'xmr-au1.nanopool.org.', 'xmr-eu1.nanopool.org.', 'xmr-eu2.nanopool.org.', 'xmr-jp1.nanopool.org.', 'xmr-us-east1.nanopool.org.', 'xmr-us-west1.nanopool.org.', 'xmr.2miners.com.', 'xmr.crypto-pool.fr.', 'xmr.gntl.uk.', 'xmr.nanopool.org.', 'xmr.pool-pay.com.', 'xmr.pool.minergate.com.', 'xmr.solopool.org.', 'xmr.volt-mine.com.', 'xmr.zeropool.io.', 'zec.antpool.com.', 'zergpool.com.', 'auto.c3pool.org.', 'us.monero.herominers.com.', 'xmr.kryptex.network.']
            uniqueId: event.name + '_' + event.comm
          id: R1008
          isTriggerAlert: true
          mitreTactic: TA0011
          mitreTechnique: T1071.004
          name: Crypto Mining Domain Communication
          profileDependency: 2
          severity: 10
          supportPolicy: false
          tags:
            - context:kubernetes
            - context:host
            - network
            - crypto
            - miners
            - malicious
            - dns
        - description: Detecting Crypto Miners by suspicious port usage.
          enabled: true
          expressions:
            message: '''Detected crypto mining related port communication on port '' + string(event.dstPort) + '' to '' + event.dstAddr + '' with protocol '' + event.proto'
            ruleExpression:
              - eventType: network
                expression: event.proto == 'TCP' && event.pktType == 'OUTGOING' && event.dstPort in [3333, 45700] && !nn.was_address_in_egress(event.containerId, event.dstAddr)
            uniqueId: event.comm + '_' + string(event.dstPort)
          id: R1009
          isTriggerAlert: false
          mitreTactic: TA0011
          mitreTechnique: T1071
          name: Crypto Mining Related Port Communication
          profileDataRequired:
            egressAddresses: all
          profileDependency: 1
          severity: 3
          state:
            ports:
              - 3333
              - 45700
          supportPolicy: false
          tags:
            - context:kubernetes
            - context:host
            - network
            - crypto
            - miners
            - malicious
            - networkprofile
        - description: Detects symlink creation over sensitive files
          enabled: true
          expressions:
            message: '''Symlink created over sensitive file: '' + event.oldPath + '' -> '' + event.newPath'
            ruleExpression:
              - eventType: symlink
                expression: (event.oldPath.startsWith('/etc/shadow') || event.oldPath.startsWith('/etc/sudoers')) && !ap.was_path_opened(event.containerId, event.oldPath)
            uniqueId: event.comm + '_' + event.oldPath
          id: R1010
          isTriggerAlert: true
          mitreTactic: TA0006
          mitreTechnique: T1005
          name: Soft link created over sensitive file
          profileDataRequired:
            opens:
              - prefix: /etc/shadow
              - prefix: /etc/sudoers
          profileDependency: 1
          severity: 5
          supportPolicy: true
          tags:
            - context:kubernetes
            - context:host
            - anomaly
            - symlink
            - applicationprofile
        - description: Detecting use of the LD_PRELOAD/LD_LIBRARY_PATH dynamic-linker hook mechanism, or an unexpected write to /etc/ld.so.preload relative to the container's application-profile baseline.
          enabled: false
          expressions:
            message: 'eventType == ''exec'' ? ''Process ('' + event.comm + '') is using a dynamic linker hook: '' + process.get_ld_hook_var(event.pid) : ''The dynamic linker configuration file ('' + event.path + '') was modified by process ('' + event.comm + '')'''
            ruleExpression:
              - eventType: exec
                expression: event.comm != 'java' && event.containerName != 'matlab' && process.get_ld_hook_var(event.pid) != ''
              - eventType: open
                expression: event.path == '/etc/ld.so.preload' && has(event.flagsRaw) && event.flagsRaw != 0
            uniqueId: 'eventType == ''exec'' ? ''exec_'' + event.comm : ''open_'' + event.path'
          id: R1011
          isTriggerAlert: true
          mitreTactic: TA0005
          mitreTechnique: T1574.006
          name: ld_preload Mechanism Use or ld.so.preload Modification
          profileDataRequired:
            opens:
              - exact: /etc/ld.so.preload
          profileDependency: 1
          severity: 5
          supportPolicy: true
          tags:
            - context:kubernetes
            - exec
            - malicious
            - applicationprofile
        - description: Detecting hardlink creation over sensitive files.
          enabled: true
          expressions:
            message: '''Hardlink created over sensitive file: '' + event.oldPath + '' - '' + event.newPath'
            ruleExpression:
              - eventType: hardlink
                expression: (event.oldPath.startsWith('/etc/shadow') || event.oldPath.startsWith('/etc/sudoers')) && !ap.was_path_opened(event.containerId, event.oldPath)
            uniqueId: event.comm + '_' + event.oldPath
          id: R1012
          isTriggerAlert: true
          mitreTactic: TA0006
          mitreTechnique: T1005
          name: Hard link created over sensitive file
          profileDataRequired:
            opens:
              - prefix: /etc/shadow
              - prefix: /etc/sudoers
          profileDependency: 1
          severity: 5
          supportPolicy: true
          tags:
            - context:kubernetes
            - files
            - malicious
            - applicationprofile
        - description: Detecting use of the ptrace syscall that was not seen in the container's application-profile baseline.
          enabled: true
          expressions:
            message: '''Unexpected ptrace syscall usage from: '' + event.comm'
            ruleExpression:
              - eventType: ptrace
                expression: "true"
            uniqueId: event.exepath + '_' + event.comm
          id: R1015
          isTriggerAlert: true
          mitreTactic: TA0005
          mitreTechnique: T1622
          name: Unexpected Ptrace Syscall Usage
          profileDependency: 2
          severity: 5
          supportPolicy: false
          tags:
            - context:kubernetes
            - context:host
            - process
            - malicious
        - description: Detects io_uring operations that were not recorded during the initial observation period, indicating potential unauthorized activity.
          enabled: true
          expressions:
            message: '''Unexpected io_uring operation detected: (opcode='' + string(event.opcode) + '') flags=0x'' + (has(event.flagsRaw) ? string(event.flagsRaw) : ''0'') + '' in '' + event.comm + ''.'''
            ruleExpression:
              - eventType: iouring
                expression: "true"
            uniqueId: string(event.opcode) + '_' + event.comm
          id: R1030
          isTriggerAlert: true
          mitreTactic: TA0002
          mitreTechnique: T1218
          name: Unexpected io_uring Operation Detected
          profileDataRequired:
            syscalls: all
          profileDependency: 0
          severity: 5
          supportPolicy: true
          tags:
            - context:kubernetes
            - context:container
            - syscalls
            - io_uring
            - applicationprofile
        - description: Detects exec operations on pods via the Kubernetes admission webhook (PodExecOptions CONNECT)
          enabled: true
          expressions:
            message: '''Exec to pod: '' + event.Name + '' in namespace '' + event.Namespace + '' by '' + event.UserInfo.Username'
            ruleExpression:
              - eventType: k8s-admission
                expression: event.Kind == "PodExecOptions"
            uniqueId: event.Namespace + '/' + event.Name
          id: R2000
          isTriggerAlert: true
          mitreTactic: TA0002
          mitreTechnique: T1609
          name: Exec to pod
          profileDependency: 2
          severity: 8
          supportPolicy: false
          tags:
            - context:kubernetes
            - admission
            - exec
        - description: Detects port-forward operations on pods via the Kubernetes admission webhook (PodPortForwardOptions CONNECT)
          enabled: true
          expressions:
            message: '''Port forward to pod: '' + event.Name + '' in namespace '' + event.Namespace + '' by '' + event.UserInfo.Username'
            ruleExpression:
              - eventType: k8s-admission
                expression: event.Kind == "PodPortForwardOptions"
            uniqueId: event.Namespace + '/' + event.Name
          id: R2001
          isTriggerAlert: true
          mitreTactic: TA0011
          mitreTechnique: T1090
          name: Port forward to pod
          profileDependency: 2
          severity: 5
          supportPolicy: false
          tags:
            - context:kubernetes
            - admission
            - network
        - description: Detects pod creation with hostPID, hostIPC or hostNetwork enabled, via the Kubernetes admission webhook
          enabled: true
          expressions:
            message: '''Pod shares host namespace ('' + ["hostPID", "hostIPC", "hostNetwork"].filter(f, f in object.spec && object.spec[f] == true).join('', '') + ''): '' + event.Namespace + ''/'' + (event.Name != '''' ? event.Name : (has(object.metadata.generateName) ? string(object.metadata.generateName) : ''unnamed'')) + '' by '' + event.UserInfo.Username'
            ruleExpression:
              - eventType: k8s-admission
                expression: event.Kind == "Pod" && event.Operation == "CREATE" && !(event.Namespace in ["kube-system", "kube-public", "kube-node-lease", "kubescape"]) && has(object.spec) && ["hostPID", "hostIPC", "hostNetwork"].exists(f, f in object.spec && object.spec[f] == true)
            uniqueId: |-
              event.Namespace + '/' + (has(object.metadata.ownerReferences) && object.metadata.ownerReferences.size() > 0
                ? string(object.metadata.ownerReferences[0].kind) + '/' + string(object.metadata.ownerReferences[0].name)
                : (event.Name != '' ? event.Name : (has(object.metadata.generateName) ? string(object.metadata.generateName) : 'unnamed')))
          id: R2002
          isTriggerAlert: true
          mitreTactic: TA0004
          mitreTechnique: T1611
          name: Pod shares host namespace
          profileDependency: 2
          severity: 6
          supportPolicy: false
          tags:
            - context:kubernetes
            - admission
            - container-escape
            - host-namespace
        - description: Detects pod creation where a container runs privileged or adds a host-breaking Linux capability, via the Kubernetes admission webhook
          enabled: true
          expressions:
            message: '''Privileged pod created: '' + event.Namespace + ''/'' + (event.Name != '''' ? event.Name : (has(object.metadata.generateName) ? string(object.metadata.generateName) : ''unnamed'')) + '' by '' + event.UserInfo.Username'
            ruleExpression:
              - eventType: k8s-admission
                expression: |-
                  event.Kind == "Pod" && event.Operation == "CREATE" && !(event.Namespace in ["kube-system", "kube-public", "kube-node-lease", "kubescape"]) && has(object.spec) && has(object.spec.containers) && (object.spec.containers
                    + (has(object.spec.initContainers) ? object.spec.initContainers : [])
                    + (has(object.spec.ephemeralContainers) ? object.spec.ephemeralContainers : [])
                  ).exists(c,
                    has(c.securityContext) &&
                    [
                      has(c.securityContext.privileged) && c.securityContext.privileged == true,
                      has(c.securityContext.capabilities) && has(c.securityContext.capabilities.add) &&
                        c.securityContext.capabilities.add.exists(cap,
                          cap in ["ALL", "SYS_ADMIN", "SYS_MODULE", "SYS_PTRACE", "SYS_RAWIO", "SYS_BOOT",
                                  "NET_ADMIN", "DAC_READ_SEARCH", "BPF", "PERFMON", "SYS_TIME"])
                    ].exists(b, b)
                  )
            uniqueId: |-
              event.Namespace + '/' + (has(object.metadata.ownerReferences) && object.metadata.ownerReferences.size() > 0
                ? string(object.metadata.ownerReferences[0].kind) + '/' + string(object.metadata.ownerReferences[0].name)
                : (event.Name != '' ? event.Name : (has(object.metadata.generateName) ? string(object.metadata.generateName) : 'unnamed')))
          id: R2003
          isTriggerAlert: true
          mitreTactic: TA0004
          mitreTechnique: T1611
          name: Privileged pod created
          profileDependency: 2
          severity: 8
          supportPolicy: false
          tags:
            - context:kubernetes
            - admission
            - container-escape
            - privileged
            - capabilities
        - description: Detects pod creation with a hostPath volume on a sensitive host location such as /, /etc, /var/lib/kubelet or the container runtime socket directories, via the Kubernetes admission webhook
          enabled: true
          expressions:
            message: '''Pod created with sensitive hostPath volume: '' + object.spec.volumes.filter(v, has(v.hostPath) && has(v.hostPath.path)).map(v, string(v.hostPath.path)).join('', '') + '' in '' + event.Namespace + ''/'' + (event.Name != '''' ? event.Name : (has(object.metadata.generateName) ? string(object.metadata.generateName) : ''unnamed'')) + '' by '' + event.UserInfo.Username'
            ruleExpression:
              - eventType: k8s-admission
                expression: |-
                  event.Kind == "Pod" && event.Operation == "CREATE" && !(event.Namespace in ["kube-system", "kube-public", "kube-node-lease", "kubescape"]) && has(object.spec) && has(object.spec.volumes) && object.spec.volumes
                    .filter(v, has(v.hostPath) && has(v.hostPath.path))
                    .map(v, "/" + string(v.hostPath.path).split("/")
                      .filter(c, c != "" && c != ".")
                      .map(c, c + "/").join(""))
                    .exists(p, [
                      p == "/",
                      ["/etc/", "/proc/", "/root/", "/home/", "/var/lib/kubelet/",
                       "/var/lib/docker/overlay2/", "/var/run/", "/run/"].exists(d, p.startsWith(d))
                    ].exists(b, b))
            uniqueId: |-
              event.Namespace + '/' + (has(object.metadata.ownerReferences) && object.metadata.ownerReferences.size() > 0
                ? string(object.metadata.ownerReferences[0].kind) + '/' + string(object.metadata.ownerReferences[0].name)
                : (event.Name != '' ? event.Name : (has(object.metadata.generateName) ? string(object.metadata.generateName) : 'unnamed')))
          id: R2004
          isTriggerAlert: true
          mitreTactic: TA0004
          mitreTechnique: T1611
          name: Pod created with sensitive hostPath volume
          profileDependency: 2
          severity: 8
          supportPolicy: false
          tags:
            - context:kubernetes
            - admission
            - container-escape
            - hostpath
        - description: Detects a ClusterRoleBinding or RoleBinding that grants the cluster-admin ClusterRole, created or given new subjects, via the Kubernetes admission webhook
          enabled: true
          expressions:
            message: |-
              'cluster-admin granted via ' + event.Kind + ' ' + (event.Namespace != '' ? event.Namespace + '/' : '') + event.Name + ' to ' + (has(object.subjects)
                ? object.subjects.map(s, string(s.kind) + ':' + (has(s.namespace) ? string(s.namespace) + '/' : '') + string(s.name)).join(', ')
                : 'no subjects') +
              ' by ' + event.UserInfo.Username
            ruleExpression:
              - eventType: k8s-admission
                expression: |-
                  [event.Kind == "ClusterRoleBinding", event.Kind == "RoleBinding"].exists(k, k) && event.Operation in ["CREATE", "UPDATE"] && has(object.roleRef) && has(object.roleRef.kind) && has(object.roleRef.name) && object.roleRef.kind == "ClusterRole" && object.roleRef.name == "cluster-admin" && (event.Operation == "CREATE"
                    ? true
                    : (has(object.subjects) ? object.subjects : []) != (has(oldObject.subjects) ? oldObject.subjects : []))
            uniqueId: 'event.Kind + ''/'' + (event.Namespace != '''' ? event.Namespace + ''/'' : '''') + event.Name'
          id: R2005
          isTriggerAlert: true
          mitreTactic: TA0003
          mitreTechnique: T1098.006
          name: cluster-admin role bound
          profileDependency: 2
          severity: 8
          supportPolicy: false
          tags:
            - context:kubernetes
            - admission
            - rbac
            - privilege-escalation
        - description: Detects a ClusterRole or Role that grants wildcard verbs, escalate/bind/impersonate, write access to RBAC objects, pod exec, token or secret resources, or secret enumeration, created or widened via the Kubernetes admission webhook
          enabled: true
          expressions:
            message: |-
              'High privileges ' + event.Kind + ' ' + (event.Namespace != '' ? event.Namespace + '/' : '') + event.Name + (event.Operation == "CREATE" ? ' created' : ' updated') + ' by ' + event.UserInfo.Username + ' granting ' + ["*", "escalate", "bind", "impersonate", "create", "update", "patch", "list", "watch"]
                .filter(v, object.rules.exists(r, has(r.verbs) && v in r.verbs)).join('/') +
              ' on ' + ["*", "clusterroles", "clusterrolebindings", "roles", "rolebindings",
               "pods/exec", "pods/attach", "serviceaccounts/token", "nodes/proxy", "secrets",
               "*/exec", "*/attach", "*/token", "*/proxy"]
                .filter(res, object.rules.exists(r, has(r.resources) && res in r.resources)).join(',')
            ruleExpression:
              - eventType: k8s-admission
                expression: |-
                  [event.Kind == "ClusterRole", event.Kind == "Role"].exists(k, k) && event.Operation in ["CREATE", "UPDATE"] && event.UserInfo.Username != "system:serviceaccount:kube-system:clusterrole-aggregation-controller" && has(object.rules) && (event.Operation == "CREATE"
                    ? true
                    : object.rules != (has(oldObject.rules) ? oldObject.rules : [])) &&
                  object.rules.exists(r,
                    has(r.verbs) && has(r.resources) && has(r.apiGroups) && [
                      r.verbs.exists(v, v in ["*", "escalate", "bind", "impersonate"]),
                      (r.apiGroups.exists(g, g in ["", "*"]) &&
                        r.verbs.exists(v, v in ["create", "update", "patch"]) &&
                        r.resources.exists(res, res in ["*", "pods/exec", "pods/attach", "serviceaccounts/token", "nodes/proxy", "secrets",
                                                        "*/exec", "*/attach", "*/token", "*/proxy"])),
                      (r.apiGroups.exists(g, g in ["rbac.authorization.k8s.io", "*"]) &&
                        r.verbs.exists(v, v in ["create", "update", "patch"]) &&
                        r.resources.exists(res, res in ["*", "clusterroles", "clusterrolebindings", "roles", "rolebindings"])),
                      (r.apiGroups.exists(g, g in ["", "*"]) &&
                        r.verbs.exists(v, v in ["list", "watch"]) &&
                        r.resources.exists(res, res in ["*", "secrets"]))
                    ].exists(b, b))
            uniqueId: 'event.Kind + ''/'' + (event.Namespace != '''' ? event.Namespace + ''/'' : '''') + event.Name'
          id: R2006
          isTriggerAlert: true
          mitreTactic: TA0004
          mitreTechnique: T1098.006
          name: High privileges role created
          profileDependency: 2
          severity: 8
          supportPolicy: false
          tags:
            - context:kubernetes
            - admission
            - rbac
            - privilege-escalation
