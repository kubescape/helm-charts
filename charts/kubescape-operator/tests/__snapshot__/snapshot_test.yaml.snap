            kubescape.io/ignore: "true"
            kubescape.io/tier: core
            tier: ks-control-plane
        spec:
          affinity: null
          containers:
            - env:
                - name: GOMEMLIMIT
                  value: 1200MiB
                - name: KS_LOGGER_LEVEL
                  value: info
                - name: KS_LOGGER_NAME
                  value: zap
              image: quay.io/kubescape/storage:v0.0.382
              imagePullPolicy: IfNotPresent
              livenessProbe:
                httpGet:
                  path: /livez
                  port: 8443
                  scheme: HTTPS
              name: apiserver
              readinessProbe:
                httpGet:
                  path: /readyz
                  port: 8443
                  scheme: HTTPS
              resources:
                limits:
                  cpu: 1500m
                  memory: 1500Mi
                requests:
                  cpu: 100m
                  memory: 400Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsNonRoot: true
              volumeMounts:
                - mountPath: /data
                  name: data
                - mountPath: /tmp
                  name: tmp-dir
                - mountPath: /etc/config/clusterData.json
                  name: ks-cloud-config
                  readOnly: true
                  subPath: clusterData.json
                - mountPath: /etc/config/config.json
                  name: config
                  readOnly: true
                  subPath: config.json
                - mountPath: /etc/storage-ca-certificates
                  name: ca-certificates
                  readOnly: true
          initContainers:
            - args:
                - --namespace
                - kubescape
                - --secret-name
                - storage-tls-init
                - --host
                - storage,storage.kubescape.svc
                - --out-dir
                - /etc/storage-ca-certificates
                - --ca-name
                - ca.crt
                - --cert-name
                - tls.crt
                - --key-name
                - tls.key
              command:
                - /usr/bin/kubescape-ops-tool
                - certgen-create
              image: quay.io/kubescape/kubescape-ops-tool:0.2.0-r1
              imagePullPolicy: IfNotPresent
              name: certgen-create
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 65532
                runAsNonRoot: true
                runAsUser: 65532
              volumeMounts:
                - mountPath: /etc/storage-ca-certificates
                  name: ca-certificates
                - mountPath: /tmp
                  name: tmp-dir
            - args:
                - --namespace
                - kubescape
                - --secret-name
                - storage-tls-init
                - --ca-name
                - ca.crt
                - --resource-type
                - apiservice
                - --resource-name
                - v1beta1.spdx.softwarecomposition.kubescape.io
                - --retries
                - "60"
                - --retry-interval
                - "5"
              command:
                - /usr/bin/kubescape-ops-tool
                - certgen-patch
              image: quay.io/kubescape/kubescape-ops-tool:0.2.0-r1
              imagePullPolicy: IfNotPresent
              name: certgen-patch
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 65532
                runAsNonRoot: true
                runAsUser: 65532
          nodeSelector:
            kubernetes.io/os: linux
          securityContext:
            fsGroup: 65532
            runAsGroup: 65532
            runAsUser: 65532
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: storage
          tolerations: null
          volumes:
            - name: data
              persistentVolumeClaim:
                claimName: kubescape-storage
            - emptyDir: {}
              name: tmp-dir
            - configMap:
                items:
                  - key: clusterData
                    path: clusterData.json
                name: ks-cloud-config
              name: ks-cloud-config
            - configMap:
                items:
                  - key: config.json
                    path: config.json
                name: storage
              name: config
            - emptyDir: {}
              name: ca-certificates
