                  value: kubescape.io
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
                - name: KS_API_AUTH_DISABLED
                  value: "true"
                - name: HELM_RELEASE
                  value: kubescape-operator-1.42.1
                - name: GOMEMLIMIT
                  value: 400MiB
                - name: KS_LOGGER_LEVEL
                  value: info
                - name: KS_LOGGER_NAME
                  value: zap
                - name: API_URL
