                  value: kubescape.io
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
                - name: KS_API_AUTH_DISABLED
                  value: "true"
                - name: GOMEMLIMIT
                  value: 819MiB
                - name: KS_LOGGER_LEVEL
                  value: info
                - name: KS_LOGGER_NAME
                  value: zap
                - name: KS_DOWNLOAD_ARTIFACTS
                  value: "true"
                - name: KS_DEFAULT_CONFIGMAP_NAME
