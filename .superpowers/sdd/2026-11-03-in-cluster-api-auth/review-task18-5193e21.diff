diff --git a/charts/kubescape-operator/templates/_apiauth.tpl b/charts/kubescape-operator/templates/_apiauth.tpl
new file mode 100644
index 0000000..662d14d
--- /dev/null
+++ b/charts/kubescape-operator/templates/_apiauth.tpl
@@ -0,0 +1,57 @@
+{{/*
+In-cluster API authentication (global.apiAuth).
+Servers (kubescape, kubevuln, synchronizer, operator) validate the caller's
+service-account token with a TokenReview for the configured audience and
+authorize it with a SubjectAccessReview in POD_NAMESPACE.
+Callers (operator, node-agent) send a projected token mounted from
+apiauth.callerVolume.
+*/}}
+
+{{- define "apiauth.tokenDir" -}}
+/var/run/secrets/kubescape.io/api-token
+{{- end -}}
+
+{{- define "apiauth.tokenFile" -}}
+{{ include "apiauth.tokenDir" . }}/token
+{{- end -}}
+
+{{/*
+Server env. Always rendered so that global.apiAuth.enabled=false reaches the
+servers as KS_API_AUTH_DISABLED.
+Usage: {{- include "apiauth.serverEnv" . | nindent 12 }}
+*/}}
+{{- define "apiauth.serverEnv" -}}
+- name: KS_API_AUDIENCE
+  value: {{ .Values.global.apiAuth.audience | quote }}
+- name: POD_NAMESPACE
+  valueFrom:
+    fieldRef:
+      fieldPath: metadata.namespace
+{{- if not .Values.global.apiAuth.enabled }}
+- name: KS_API_AUTH_DISABLED
+  value: "true"
+{{- end }}
+{{- end -}}
+
+{{/*
+Projected service-account token volume for callers; empty when apiAuth is disabled.
+*/}}
+{{- define "apiauth.callerVolume" -}}
+{{- if .Values.global.apiAuth.enabled -}}
+- name: kubescape-api-token
+  projected:
+    sources:
+      - serviceAccountToken:
+          audience: {{ .Values.global.apiAuth.audience | quote }}
+          expirationSeconds: 3600
+          path: token
+{{- end }}
+{{- end -}}
+
+{{- define "apiauth.callerVolumeMount" -}}
+{{- if .Values.global.apiAuth.enabled -}}
+- name: kubescape-api-token
+  mountPath: {{ include "apiauth.tokenDir" . }}
+  readOnly: true
+{{- end }}
+{{- end -}}
diff --git a/charts/kubescape-operator/templates/configs/api-auth-rbac.yaml b/charts/kubescape-operator/templates/configs/api-auth-rbac.yaml
new file mode 100644
index 0000000..5a0af47
--- /dev/null
+++ b/charts/kubescape-operator/templates/configs/api-auth-rbac.yaml
@@ -0,0 +1,108 @@
+{{- /*
+RBAC for in-cluster API authentication (global.apiAuth).
+Each server gets system:auth-delegator so it can create TokenReviews and
+SubjectAccessReviews; each caller gets a Role in ksNamespace granting the
+kubescape.io verbs the servers check.
+*/}}
+{{- $components := fromYaml (include "components" .) }}
+{{- if .Values.global.apiAuth.enabled }}
+{{- $servers := list }}
+{{- if $components.kubescape.enabled }}{{- $servers = append $servers .Values.kubescape.name }}{{- end }}
+{{- if $components.kubevuln.enabled }}{{- $servers = append $servers .Values.kubevuln.name }}{{- end }}
+{{- if $components.synchronizer.enabled }}{{- $servers = append $servers .Values.synchronizer.name }}{{- end }}
+{{- if $components.operator.enabled }}{{- $servers = append $servers .Values.operator.name }}{{- end }}
+{{- range $name := $servers }}
+---
+apiVersion: rbac.authorization.k8s.io/v1
+kind: ClusterRoleBinding
+metadata:
+  name: {{ printf "%s:system:auth-delegator" $name | quote }}
+  annotations:
+    {{- include "kubescape-operator.annotations" (dict "Values" $.Values) | nindent 4 }}
+  labels:
+    {{- include "kubescape-operator.labels" (dict "Chart" $.Chart "Release" $.Release "Values" $.Values "app" $name "tier" $.Values.global.namespaceTier) | nindent 4 }}
+roleRef:
+  apiGroup: rbac.authorization.k8s.io
+  kind: ClusterRole
+  name: system:auth-delegator
+subjects:
+- kind: ServiceAccount
+  name: {{ $name }}
+  namespace: {{ $.Values.ksNamespace }}
+{{- end }}
+{{- if $components.operator.enabled }}
+---
+apiVersion: rbac.authorization.k8s.io/v1
+kind: Role
+metadata:
+  name: operator-api-caller
+  namespace: {{ .Values.ksNamespace }}
+  annotations:
+    {{- include "kubescape-operator.annotations" (dict "Values" .Values) | nindent 4 }}
+  labels:
+    {{- include "kubescape-operator.labels" (dict "Chart" .Chart "Release" .Release "Values" .Values "app" .Values.operator.name "tier" .Values.global.namespaceTier) | nindent 4 }}
+rules:
+  - apiGroups: ["kubescape.io"]
+    resources: ["scans", "scanresults"]
+    verbs: ["create", "get", "delete"]
+  - apiGroups: ["kubescape.io"]
+    resources: ["vulnerabilityscans"]
+    verbs: ["create", "get"]
+  - apiGroups: ["kubescape.io"]
+    resources: ["runtimealerts", "registrystatuses"]
+    verbs: ["create"]
+---
+apiVersion: rbac.authorization.k8s.io/v1
+kind: RoleBinding
+metadata:
+  name: operator-api-caller
+  namespace: {{ .Values.ksNamespace }}
+  annotations:
+    {{- include "kubescape-operator.annotations" (dict "Values" .Values) | nindent 4 }}
+  labels:
+    {{- include "kubescape-operator.labels" (dict "Chart" .Chart "Release" .Release "Values" .Values "app" .Values.operator.name "tier" .Values.global.namespaceTier) | nindent 4 }}
+roleRef:
+  apiGroup: rbac.authorization.k8s.io
+  kind: Role
+  name: operator-api-caller
+subjects:
+- kind: ServiceAccount
+  name: {{ .Values.operator.name }}
+  namespace: {{ .Values.ksNamespace }}
+{{- end }}
+{{- if $components.nodeAgent.enabled }}
+---
+apiVersion: rbac.authorization.k8s.io/v1
+kind: Role
+metadata:
+  name: node-agent-api-caller
+  namespace: {{ .Values.ksNamespace }}
+  annotations:
+    {{- include "kubescape-operator.annotations" (dict "Values" .Values) | nindent 4 }}
+  labels:
+    {{- include "kubescape-operator.labels" (dict "Chart" .Chart "Release" .Release "Values" .Values "app" .Values.nodeAgent.name "tier" .Values.global.namespaceTier) | nindent 4 }}
+rules:
+  # Keep in sync with httpEndpoint.resources in templates/synchronizer/configmap.yaml.
+  - apiGroups: ["kubescape.io"]
+    resources: ["networkstreams", "nodeprofiles", "runtimealerts", "registrystatuses", "aisandboxheartbeats"]
+    verbs: ["create"]
+---
+apiVersion: rbac.authorization.k8s.io/v1
+kind: RoleBinding
+metadata:
+  name: node-agent-api-caller
+  namespace: {{ .Values.ksNamespace }}
+  annotations:
+    {{- include "kubescape-operator.annotations" (dict "Values" .Values) | nindent 4 }}
+  labels:
+    {{- include "kubescape-operator.labels" (dict "Chart" .Chart "Release" .Release "Values" .Values "app" .Values.nodeAgent.name "tier" .Values.global.namespaceTier) | nindent 4 }}
+roleRef:
+  apiGroup: rbac.authorization.k8s.io
+  kind: Role
+  name: node-agent-api-caller
+subjects:
+- kind: ServiceAccount
+  name: {{ .Values.nodeAgent.name }}
+  namespace: {{ .Values.ksNamespace }}
+{{- end }}
+{{- end }}
